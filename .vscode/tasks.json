{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: backend (venv + packages)",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt -r requirements-ml.txt && ([ -f .env ] || cp .env.example .env)",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Setup: frontend (npm install)",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Run: frontend dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^x" },
        "background": { "activeBegins": "VITE", "activeEnds": "Local:" }
      }
    },
    {
      "label": "Run: everything in Docker",
      "type": "shell",
      "command": "docker compose up --build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Test: backend",
      "type": "shell",
      "command": ".venv/bin/pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
