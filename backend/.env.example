# Copy to backend/.env and fill in what you have. Everything is optional:
# with no keys at all the app still runs in basic mode.

# --- AI model -------------------------------------------------------------
# anthropic (best), ollama (free, local, no web search) or none (fact-check matching only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5          # verification and reasoning
LLM_FAST_MODEL=claude-haiku-5-5    # claim extraction and summaries
LLM_WEB_SEARCH=true                # let Claude search the web itself
LLM_MAX_SEARCHES_PER_CLAIM=3
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- Evidence sources -----------------------------------------------------
# Free key: https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=
ENABLE_WIKIPEDIA=true
# Optional web search APIs (use either)
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- Server ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
STORE_INPUT_TEXT=true       # false = don't keep pasted text in history
RATE_LIMIT=30/minute
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (default: SQLite in backend/data)

# --- Live monitor (Live page): reads public Bluesky posts as they are written
# MONITOR_ENABLED=true
